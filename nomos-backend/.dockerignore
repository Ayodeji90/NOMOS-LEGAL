# Docker ignore patterns for slim image
# Week 8 E1: Exclude unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
tests/

# Documentation
*.md
docs/
*.rst

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Data files (corpora stored in GCS, not in image)
app/data/corpora/
app/data/raw/
*.xml
*.json
!app/data/za_synonyms.json

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Scripts (not needed in runtime image)
scripts/
