# NOMOS Backend - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application
# =============================================================================
APP_NAME=nomos-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8080
WORKERS=1

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
# Local development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nomos

# Production (Cloud SQL / AlloyDB)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nomos?sslmode=require

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis (Memorystore)
# =============================================================================
# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Memorystore)
# REDIS_URL=redis://host:6379/0

REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# Firestore (Sessions)
# =============================================================================
# Local development (emulator)
FIRESTORE_PROJECT_ID=nomos-dev
FIRESTORE_DATABASE=(default)

# Production
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# FIRESTORE_DATABASE=(default)

SESSION_TTL_DAYS=30

# =============================================================================
# Google Cloud / Vertex AI
# =============================================================================
GCP_PROJECT_ID=nomos-dev
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1

# =============================================================================
# Model Configuration
# =============================================================================
MODEL_QUERY_UNDERSTANDING=gemini-1.5-flash
MODEL_EMBEDDING=text-embedding-005
MODEL_RERANK=gemini-1.5-flash
MODEL_WRITER=gemini-1.5-pro
MODEL_VERIFIER=gemini-1.5-flash
MODEL_FALLBACK_WRITER=claude-3-5-sonnet-20241022

QUERY_UNDERSTANDING_TEMPERATURE=0.1
QUERY_UNDERSTANDING_MAX_TOKENS=1024
RERANK_TEMPERATURE=0.0
RERANK_MAX_TOKENS=512
WRITER_TEMPERATURE=0.2
WRITER_MAX_TOKENS=4096
VERIFIER_TEMPERATURE=0.0
VERIFIER_MAX_TOKENS=2048

EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100

# =============================================================================
# Retrieval Configuration
# =============================================================================
RETRIEVAL_TOP_K_SPARSE=50
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_RRF_K=60
RERANK_TOP_K=12
COVERAGE_THRESHOLD=0.35

# =============================================================================
# Rate Limiting & Quotas
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_HOUR=500
RATE_LIMIT_BURST=10
QUOTA_DAILY_QUERIES=100
QUOTA_DAILY_WRITER_CALLS=20

# =============================================================================
# Authentication
# =============================================================================
# CHANGE THIS IN PRODUCTION - generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

API_KEY_PREFIX=nomos_
API_KEY_HASH_ROUNDS=12

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000", "http://127.0.0.1:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# Cloud Storage
# =============================================================================
# GCS_BUCKET_SOURCES=your-bucket-sources
# GCS_BUCKET_CORPUS=your-bucket-corpus
# GCS_BUCKET_EVAL=your-bucket-eval

# =============================================================================
# Ingestion
# =============================================================================
INGESTION_CHUNK_MAX_TOKENS=512
INGESTION_CHUNK_OVERLAP_TOKENS=50

# =============================================================================
# Evaluation
# =============================================================================
EVAL_GOLDEN_SET_PATH=eval/golden_sets/za.jsonl
EVAL_NIGHTLY_ENABLED=true

# =============================================================================
# Feature Flags
# =============================================================================
FLAG_AGENT_LOOP_ENABLED=false
FLAG_CASE_LAW_ENABLED=false
FLAG_REGULATIONS_ENABLED=false
FLAG_VERIFICATION_REPAIR_ENABLED=true

# =============================================================================
# Observability
# =============================================================================
ENABLE_REQUEST_LOGGING=true
ENABLE_QUERY_TRACING=true
TRACE_SAMPLE_RATE=1.0
LOG_PROMPTS=false
LOG_RESPONSES=false

# =============================================================================
# South Africa Specific
# =============================================================================
ZA_JURISDICTION_ID=za
ZA_JURISDICTION_NAME=South Africa
ZA_SYNONYM_DICT_PATH=app/data/za_synonyms.json